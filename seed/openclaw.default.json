{
  "gateway": {
    "mode": "local",
    "port": 8080,
    "bind": "lan",
    "auth": {
      "mode": "password",
      "password": "pass1122"
    },
    "controlUi": {
      "allowInsecureAuth": true,
      "dangerouslyDisableDeviceAuth": true,
      "dangerouslyAllowHostHeaderOriginFallback": true
    }
  },

  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": {
        "primary": "cloudflare-openai/openai/gpt-5.4-mini"
      },
      "sandbox": {
        "mode": "off"
      }
    },

    "list": [
      {
        "id": "main",
        "tools": {
          "elevated": {
            "enabled": true,
            "allowFrom": {
              "webchat": ["*"]
            }
          }
        }
      }
    ]
  },

  "commands": {
    "bash": true,
    "plugins": true
  },

  "update": {
    "checkOnStart": false
  },

  "discovery": {
    "mdns": {
      "mode": "true"
    }
  },

  "browser": {
    "enabled": false
  },

  "plugins": {
    "entries": {
      "cloudflare-ai-gateway": {
        "enabled": true
      },
      "openai": {
        "enabled": true
      },
      "ollama": {
        "enabled": true
      },
      "anthropic": {
        "enabled": true
      },
      "google": {
        "enabled": true
      },
      "mistral": {
        "enabled": true
      },
      "deepseek": {
        "enabled": true
      },
      "openrouter": {
        "enabled": true
      },
      "xai": {
        "enabled": true
      }
    }
  },

  "hooks": {
    "internal": {
      "entries": {
        "sync-status-inject": {
          "enabled": true
        },
        "bootstrap-extra-files": {
          "enabled": true,
          "paths": [
            "sync/AGENTS.md"
          ]
        }
      }
    }
  },

  "session": {
    "dmScope": "per-channel-peer"
  },

  "tools": {
    "profile": "coding",
    "elevated": {
      "enabled": true,
      "allowFrom": {
        "webchat": ["*"]
      }
    }
  },

  "auth": {
    "profiles": {
      "anthropic:default": {
        "provider": "anthropic",
        "mode": "api_key"
      },
      "google:default": {
        "provider": "google",
        "mode": "api_key"
      },
      "mistral:default": {
        "provider": "mistral",
        "mode": "api_key"
      },
      "openai:api-key": {
        "provider": "openai",
        "mode": "api_key"
      },
      "openrouter:default": {
        "provider": "openrouter",
        "mode": "api_key"
      },
      "xai:default": {
        "provider": "xai",
        "mode": "api_key"
      }
    }
  },

  "models": {
    "mode": "merge",

    "providers": {
      "cloudflare-openai": {
        "baseUrl": "https://gateway.ai.cloudflare.com/v1/b73b80fa62deef032d3c08248cf2f30b/default/compat",
        "api": "openai-completions",
        "apiKey": "CHANGE_THIS_CLOUDFLARE_GATEWAY_TOKEN",
        "timeoutSeconds": 300,

        "models": [
          {
            "id": "openai/gpt-5.4-mini",
            "name": "GPT-5.4 Mini",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 8192
          }
        ]
      },

      "xai": {
        "baseUrl": "https://api.x.ai/v1",
        "api": "openai-responses",

        "models": [
          {
            "id": "grok-build-0.1",
            "name": "Grok Build 0.1",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 1,
              "output": 2,
              "cacheRead": 0.2,
              "cacheWrite": 0
            },
            "contextWindow": 256000,
            "maxTokens": 64000
          },

          {
            "id": "grok-4.3",
            "name": "Grok 4.3",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 1.25,
              "output": 2.5,
              "cacheRead": 0.2,
              "cacheWrite": 0
            },
            "contextWindow": 1000000,
            "maxTokens": 64000
          }
        ]
      }
    }
  }
}